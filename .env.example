# CodeGuardian AI Environment Variables Template

# Database Connection (PostgreSQL for Production, fallback to SQLite if empty)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/codeguardian

# Secret Key for JWT Token Generation
SECRET_KEY=change_this_to_a_secure_random_string_in_production_1234567890

# OpenAI API Key (Required for AI Code Analysis)
OPENAI_API_KEY=sk-proj-your-openai-api-key-here

# Redis & Celery (Optional in Serverless Vercel deployment)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# GitHub OAuth Integration
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_REDIRECT_URI=http://localhost:3000/api/v1/auth/github/callback

# Google OAuth Integration
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Microsoft OAuth Integration
MICROSOFT_CLIENT_ID=your_microsoft_client_id
MICROSOFT_CLIENT_SECRET=your_microsoft_client_secret

# Application URLs & CORS
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
ALLOWED_ORIGINS=http://localhost:3000,https://*.vercel.app

# Next.js Public API Base URL
NEXT_PUBLIC_API_URL=
